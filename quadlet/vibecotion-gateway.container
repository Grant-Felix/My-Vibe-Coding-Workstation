# Vibe Coding Workstation — 网关容器（对外唯一入口）
#
# 职责：接收 9999 上的全部流量，按 Host 头分发到各服务容器。
# 与门户分离：门户只做导航，网关只做转发。门户挂掉不影响服务可达性。
#
# 路由规则见 config/gateway/Caddyfile
[Unit]
Description=Vibe WS: Gateway (single entry on :9999)
After=vibecotion-network.service
Requires=vibecotion-network.service

[Container]
ContainerName=vibecotion-gateway
Image=docker.io/library/caddy:2.10-alpine
Pod=vibecotion.pod

# ⚠️ 不在此声明 Network= 或 PublishPort=：
#    Pod 成员必须共享 Pod 的网络命名空间，端口发布由 .pod 唯一拥有。
#    同时声明 --network 与 --pod 会被 podman 拒绝（二者互斥）。

# 配置只读挂载（单一来源：仓库内 config/，由 install.sh 同步到 ~/.config/vibecotion/）
Volume=%h/.config/vibecotion/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=%h/.config/vibecotion/home:/srv:ro,Z
Volume=vibecotion-gateway-data.volume:/data:Z
Volume=vibecotion-gateway-config.volume:/config:Z

# 配置校验失败则拒绝启动，避免静默降级
HealthCmd=wget -q --spider http://127.0.0.1:9999/healthz || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
