# Vibe Coding Workstation — Forgejo（自托管 Git）
[Unit]
Description=Vibe WS: Forgejo
After=vibecotion-network.service
Requires=vibecotion-network.service

[Container]
ContainerName=vibecotion-forgejo
# ⚠️ 官方镜像在 Codeberg 自己的 registry，**不在 Docker Hub**。
#    已核实：docker.io/codeberg/forgejo 与 docker.io/forgejo/forgejo 均为 404。
#    官方文档（forgejo.org/docs/latest/admin/installation-docker）给出
#    Quadlet 示例即为：Image=codeberg.org/forgejo/forgejo:16
Image=codeberg.org/forgejo/forgejo:16
Pod=vibecotion.pod

Volume=vibecotion-forgejo-data.volume:/data:Z

# 对外访问的根 URL：经网关 + Cloudflare，必须与实际访问地址一致
Environment=FORGEJO__server__ROOT_URL=https://git.vibecotion.wraindrock.com/
Environment=FORGEJO__server__DOMAIN=git.vibecotion.wraindrock.com
Environment=FORGEJO__server__SSH_DOMAIN=git.vibecotion.wraindrock.com
Environment=FORGEJO__server__HTTP_PORT=3000
# 反代终止 TLS：显式声明，否则 Forgejo 生成的绝对链接会用 http
Environment=FORGEJO__server__PROTOCOL=http
# 首次安装免交互
Environment=FORGEJO__security__INSTALL_LOCK=true
Environment=FORGEJO__service__DISABLE_REGISTRATION=true

ExposeHostPort=3000
# 只依据数据目录判断 —— 不依赖镜像内的二进制路径或 wget/curl，
# 那些都未经核实。app.ini 由 Forgejo 首次启动生成，是可靠的存活标志。
HealthCmd=test -f /data/gitea/conf/app.ini
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=60s

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
