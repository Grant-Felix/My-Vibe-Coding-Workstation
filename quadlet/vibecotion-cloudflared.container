# Vibe Coding Workstation — Cloudflare Tunnel 连接器
#
# 出站连接：不需要公网 IP、不需要端口转发、宿主不开放任何入站端口。
# 流量路径：公网 → Cloudflare 边缘 → 本容器（出站隧道）→ 网关:9999
#
# ⚠️ TUNNEL_TOKEN 不写在此文件（本文件入库，仓库为 Public）。
#    由 install.sh 从 ~/.config/vibecotion/cloudflared.env 读取并写入
#    系统级环境文件，本单元通过 EnvironmentFile 引用。
[Unit]
Description=Vibe WS: Cloudflare Tunnel connector
After=vibecotion-gateway.service
Requires=vibecotion-gateway.service

[Container]
ContainerName=vibecotion-cloudflared
Image=docker.io/cloudflare/cloudflared:latest
Pod=vibecotion.pod

# 凭证外置；文件由 install.sh 生成，权限 600
EnvironmentFile=%h/.config/vibecotion/cloudflared.env

# --no-autoupdate：容器内自更新会绕过镜像版本管理，破坏可复现性
Exec=--no-autoupdate tunnel run

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
