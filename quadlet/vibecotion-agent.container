# Vibe Coding Workstation — Agent 容器
#
# 默认 agent：DeepSeek Harness（DSH），本地自建镜像（见 agent/Dockerfile）。
# 设计为**可替换**：改 Image= 即可切换 agent。
#
# 决策 D14：DSH 在容器内独立安装，不挂载宿主 Node/DSH 安装。
[Unit]
Description=Vibe WS: Agent (DeepSeek Harness)
After=vibecotion-network.service
Requires=vibecotion-network.service

[Container]
ContainerName=vibecotion-agent
# 本地构建标签。带 registry 前缀是为避免 podman 误向远端拉取同名镜像。
# 由 install.sh 构建；镜像缺失时先跑 install.sh。
Image=localhost/vibecotion-agent:latest

Pod=vibecotion.pod

# DSH_HOME（profiles + 凭证）与工作目录分开两个卷：
# 前者需可备份/可迁移，后者是易失的工作产出。
Volume=vibecotion-agent-dsh.volume:/home/agent/.dsh:Z
Volume=vibecotion-agent-data.volume:/home/agent/workspace:Z

Environment=DSH_HOME=/home/agent/.dsh
Environment=HOME=/home/agent
Environment=NODE_ENV=production
Environment=DSH_WEB_PORT=3080

# 健康检查用 127.0.0.1（容器自身回环）；Pod 内成员共享网络命名空间，
# 探测自身端口即可反映服务是否存活。
# 用 curl 而非 wget —— Fedora 基础镜像两者都不带，
# 而 agent 镜像只装了 curl（见 agent/Dockerfile）。
HealthCmd=curl -fsS -o /dev/null http://127.0.0.1:3080/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=90s

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
