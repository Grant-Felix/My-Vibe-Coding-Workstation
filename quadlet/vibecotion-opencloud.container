# Vibe Coding Workstation — OpenCloud
#
# ⚠️ 本项目自行解决了两处官方 compose 不适用的问题（见 design.md 4.1）：
#   1. 官方 Traefik 挂载 docker.sock 且不可关闭 → 不用官方 Traefik，
#      由本 Pod 的网关（Caddy）承担反代，OpenCloud 自身只跑主服务。
#   2. 官方通过 Traefik 按 Host 路由 → 由网关按 Host 转发并保留 Host 头。
#
# OC_URL 必须是**外部实际访问地址**，否则生成的绝对链接错误。
[Unit]
Description=Vibe WS: OpenCloud
After=vibecotion-network.service
Requires=vibecotion-network.service

[Container]
ContainerName=vibecotion-opencloud
Image=docker.io/opencloudeu/opencloud-rolling:8.0.1
Pod=vibecotion.pod

# 官方镜像以 1000:1000 运行
User=1000:1000

# ⚠️ 镜像自身的 Entrypoint 是 ['/usr/bin/opencloud']。
#    若只写 Exec=，命令会被当作 opencloud 的**子命令**追加进去
#      → /usr/bin/opencloud /bin/sh -c ... → 无效子命令 → 容器立即退出。
#    （真实故障：opencloud 启动失败。）已核实镜像 config.Entrypoint。
#    因此必须显式覆盖 Entrypoint，与官方 compose 的写法一致。
#
# init 生成配置与随机密钥（幂等：已存在则报错，故 || true）；
# 随后启动服务。密钥落在持久卷，重建容器不会变 —— 这是必需的。
Entrypoint=/bin/sh
Exec=-c "opencloud init || true; opencloud server"

Volume=vibecotion-opencloud-config.volume:/etc/opencloud:Z
Volume=vibecotion-opencloud-data.volume:/var/lib/opencloud:Z

# 外部访问地址（经网关 + Cloudflare），OpenCloud 据此生成链接
Environment=OC_URL=https://cloud.vibecotion.wraindrock.com
# 网关在 Pod 内，明文 HTTP 转发；TLS 由 Cloudflare 边缘终结
Environment=PROXY_TLS=false
# 自签/边缘证书场景需要跳过校验（Pod 内不涉及，保守开启）
Environment=OC_INSECURE=false
Environment=OC_LOG_LEVEL=info
# 初始管理员密码：由 install.sh 从本地凭证文件注入，不硬编码
EnvironmentFile=%h/.config/vibecotion/opencloud.env
# 默认语言
Environment=OC_DEFAULT_LANGUAGE=zh_CN

ExposeHostPort=9200
# 只依据配置目录判断 —— opencloud init 会写入该文件，是可靠的存活标志。
HealthCmd=test -f /etc/opencloud/opencloud.yaml
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=120s

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
