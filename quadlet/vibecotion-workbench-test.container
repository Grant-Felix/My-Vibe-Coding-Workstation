# Vibe Coding Workstation — Workbench (test)
#
# 测试环境，从干净基线起。
#
# 三环境（dev/test/staging）**共享镜像层**（省磁盘），
# 但**数据卷与运行状态完全隔离**，互不污染。
# 可通过 reset.sh 重置回「刚安装」状态。
[Unit]
Description=Vibe WS: Workbench test
After=vibecotion-network.service
Requires=vibecotion-network.service

[Container]
ContainerName=vibecotion-workbench-test
# 本地构建（见 workbench/Dockerfile）。
# ⚠️ 不可改用 debian:13-slim 之类的基础镜像 —— 其默认命令是 bash，
#    无 TTY 会立即退出，配合 Restart=always 形成崩溃循环。
#    镜像必须自带常驻命令。
Image=localhost/vibecotion-workbench:latest
Pod=vibecotion.pod

Volume=vibecotion-workbench-test.volume:/work:Z

Environment=WORKBENCH_ENV=test

# 健康检查反映「容器仍常驻」这一事实：
# 工作台本身不监听端口，故检查工作目录存在且 PID 1 存活。
HealthCmd=test -d /work && kill -0 1
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
